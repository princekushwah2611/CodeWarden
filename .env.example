# GitHub App Configuration
GITHUB_APP_ID=
GITHUB_APP_SLUG=              # The URL-friendly name of your GitHub App (from App settings page URL)
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=
# GitHub OAuth (same App — found in App Settings → Client ID / Generate a client secret)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Anthropic (Claude) — LLM reasoning layer
ANTHROPIC_API_KEY=

# OpenAI — Embeddings for RAG pipeline
OPENAI_API_KEY=

# Database
DATABASE_URL="file:./codewarden.db"

# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=change-me-in-production
APP_URL=http://localhost:5173

# ChromaDB
CHROMA_URL=http://localhost:8000
